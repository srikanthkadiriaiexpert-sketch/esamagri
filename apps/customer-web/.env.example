# apps/customer-web — environment configuration template.
#
# Copy to .env.local for local development:
#   cp apps/customer-web/.env.example apps/customer-web/.env.local
# .env.local is git-ignored (see repo .gitignore).
#
# Vite exposes only VITE_-prefixed variables to client code, by design —
# that boundary is intentional here. NEVER add a secret to this file or
# to any VITE_ variable: everything here ships inside the browser bundle
# and is readable by anyone who opens the app. Credentials, tokens, and
# API keys belong in apps/api's environment only.
#
# Validated at build/dev-server start by @esamagri/config
# (customerWebEnvSchema) — see packages/config/src/customer-web-env.ts.

VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=e Samagri
VITE_ENVIRONMENT=development
