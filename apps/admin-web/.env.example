# apps/admin-web — environment configuration template.
#
# Copy to .env.local for local development:
#   cp apps/admin-web/.env.example apps/admin-web/.env.local
# .env.local is git-ignored (see repo .gitignore).
#
# Vite exposes only VITE_-prefixed variables to client code, by design.
# NEVER add a secret to this file or to any VITE_ variable: everything
# here ships inside the browser bundle. Staff authentication (password,
# TOTP) and all authorization happen server-side in apps/api.
#
# Validated at build/dev-server start by @esamagri/config
# (adminWebEnvSchema) — see packages/config/src/admin-web-env.ts.

VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=e Samagri Admin
VITE_ENVIRONMENT=development
