{
  "name": "@esamagri/api",
  "version": "0.1.0",
  "private": true,
  "description": "e Samagri backend — NestJS, TypeScript, REST API. Long-running service, deployed separately from the Vercel frontends per the approved Phase 3B architecture. STEP 4: module-boundary skeleton + health endpoint. STEP 5: database connection infrastructure. STEP 6: shared authentication/session infrastructure (customer OTP, staff password+TOTP, JWT access + rotating refresh sessions) against the frozen Phase 2 schema — no schema change. RIK/PIF business logic and the full RBAC matrix (STEP 7) land in later steps.",
  "scripts": {
    "dev": "node --watch --require ts-node/register/transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration.spec.ts",
    "test:integration": "jest integration.spec.ts"
  },
  "dependencies": {
    "@esamagri/config": "0.1.0",
    "@esamagri/shared-types": "0.1.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "helmet": "^8.1.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
