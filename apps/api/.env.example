# apps/api — environment configuration template.
#
# Copy this file to .env for local development ONLY.
#   cp apps/api/.env.example apps/api/.env
# .env is git-ignored (see repo .gitignore) and must never be committed.
#
# In staging/production, these are set through the deployment platform's
# environment/secret configuration, never through a committed file.
#
# Fields marked SECRET must:
#   - never be hardcoded in source,
#   - never be logged,
#   - never be reused between environments (dev/staging/prod each get
#     their own values),
#   - be generated with a real secret generator for anything beyond
#     local development (e.g. `openssl rand -base64 48`).
#
# This file is validated at startup by @esamagri/config (apiEnvSchema).
# A missing or malformed required value makes the service refuse to
# start, with every problem listed — see packages/config/src/api-env.ts.

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database (frozen Phase 2 schema; connection settings only) --------
# SECRET (embeds the DB password)
DATABASE_URL=postgresql://esamagri_dev:changeme@localhost:5432/esamagri_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- JWT access token ----------------------------------------------------
# SECRET — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_A_REAL_LOCAL_ONLY_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=15m

# --- Refresh session cookie ----------------------------------------------
REFRESH_COOKIE_NAME=esamagri_rt

# LEAVE THIS EMPTY unless a deployment genuinely needs one cookie shared
# across subdomains.
#
# Empty means the Domain attribute is omitted entirely and the cookie becomes
# HOST-ONLY: the browser binds it to exactly the host that was asked. That is
# the only form which serves http://localhost:5173 AND a LAN address such as
# http://192.168.1.20:5173 from one unchanged configuration — `Domain=localhost`
# is refused outright by any other host, and an IP address is not a legal
# Domain value at all. This file previously said `localhost`, which worked on
# the development machine and silently broke every phone on the LAN.
#
# In production set this ONLY if the app and the API are on different
# subdomains of one registrable domain (for example `.esamagri.example`), and
# then set it to that parent domain. If app and API share a host, leave it
# empty here too.
REFRESH_COOKIE_DOMAIN=

# 365 days, ROLLING: every refresh extends it by another full year, so a
# customer who uses the app is never asked for an OTP again. There is no
# absolute cap by design. See packages/config/src/api-env.ts for why a long
# lifetime is safe here (opaque rotating tokens, hash-only storage, reuse
# detection, and staff revocation).
REFRESH_TOKEN_TTL_DAYS=365

# --- Password hashing (staff accounts) ------------------------------------
BCRYPT_SALT_ROUNDS=12

# --- Staff TOTP ------------------------------------------------------------
STAFF_TOTP_ISSUER=e Samagri

# --- Staff login brute-force protection -------------------------------------
# Enforced by counting recent STAFF_LOGIN_FAILURE rows in shared.audit_log
# (no separate login-attempts table exists, or is needed).
STAFF_LOGIN_MAX_FAILURES_PER_WINDOW=5
STAFF_LOGIN_LOCKOUT_WINDOW_SECONDS=900

# --- Customer OTP auth -----------------------------------------------------
# SECRET — pepper mixed into the OTP hash before it is stored.
# Generate with: openssl rand -base64 32
OTP_HASH_PEPPER=REPLACE_WITH_A_REAL_LOCAL_ONLY_PEPPER_AT_LEAST_16_CHARS
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_REQUEST_MAX_PER_WINDOW=5

# --- OTP delivery channel (config-dependent integration boundary) --------
# NONE | WHATSAPP | SMS_GATEWAY_HUB
#
# NONE is the shipped default and sends nothing. SMS_GATEWAY_HUB sends
# real SMS and requires the two credentials in the block below — select
# it and the API refuses to start without them.
#
# SMS_2FACTOR and SMS_GATEWAY are no longer accepted and the API refuses
# to start on either, by name. (SMS_GATEWAY_HUB is a different value and
# is not affected by that refusal.) WHATSAPP remains spellable because
# the WhatsApp settings below also govern order notifications — but it
# buys no OTP delivery, and selecting it makes every code issue log an
# error and record OTP_DELIVERY_FAILED.
#
# The generated OTP code is never logged or returned in any API response
# — see CustomerAuthService. Never fabricate a "sent" result.
OTP_DELIVERY_PROVIDER=NONE

# --- SMS Gateway Hub (OTP SMS delivery) -----------------------------------
# Required only when OTP_DELIVERY_PROVIDER=SMS_GATEWAY_HUB.
#
# SECRET — SMS_GATEWAY_HUB_API_KEY. PLACEHOLDER ONLY IN THIS FILE.
# The real key belongs in apps/api/.env on the machine that runs the API,
# and nowhere else: not in this file, not in a commit, not in a
# screenshot, not in a chat message. Get it from the provider's panel:
#   https://www.smsgatewayhub.com/Panel/WebAPI/APICodes.aspx
# The API validates that it is present without ever printing its value.
SMS_GATEWAY_HUB_API_KEY=
# Your DLT-approved sender header (the vendor documents six characters).
SMS_GATEWAY_HUB_SENDER_ID=
#
# --- DLT identifiers — REQUIRED; the API refuses to start without them ----
#
# Both are sent on every message by the GET SendSMS API. Without them the
# gateway ACCEPTS the request (ErrorCode 000) and DLT scrubbing then
# discards it — so a sign-in looks successful and no code is ever
# delivered. That silent failure is why these are required, not optional.
#
# NOT SECRETS, but placeholders here all the same. Both are DLT
# registration identifiers, visible in the provider's panel and returned
# in plain text by its own APIs:
#   SMS_GATEWAY_HUB_ENTITY_ID        -> Principal Entity ID  (getsenderid)
#   SMS_GATEWAY_HUB_DLT_TEMPLATE_ID  -> Content Template ID  (gettemplates)
# Both are all-digit values — 19 digits on the Indian registries today.
#
# COPY THEM EXACTLY, from the API response rather than from a screenshot.
# One dropped digit gives an 18-digit ID that matches no template, and the
# gateway's reply does not say so: it answers 007, "username or password
# is invalid", which sends you looking at the API key instead. That single
# missing digit cost a day of diagnosis on this integration.
SMS_GATEWAY_HUB_ENTITY_ID=
SMS_GATEWAY_HUB_DLT_TEMPLATE_ID=
# Vendor document page 10: Route=1 (default), Channel=2 (transactional),
# DCS=0 (English; 8 = Unicode). Leave these alone unless SMS Gateway Hub
# tells you your account uses different values. FlashSms is fixed at 0 in
# code and is not a setting.
SMS_GATEWAY_HUB_ROUTE=1
SMS_GATEWAY_HUB_CHANNEL=2
SMS_GATEWAY_HUB_DCS=0
# How long a sign-in waits for the gateway before giving up, in
# milliseconds. Exceeding it records OTP_DELIVERY_FAILED; it never makes
# the sign-in itself fail.
SMS_GATEWAY_HUB_TIMEOUT_MS=10000

# The endpoint is deliberately NOT configurable. It is fixed in
# apps/api/src/notification/smsgatewayhub.provider.ts because the request
# body carries the API key, and a URL read from this file is a URL a typo
# can point at someone else's server.

# --- WhatsApp Business Platform (official API only) -----------------------
# Required only when OTP_DELIVERY_PROVIDER=WHATSAPP or WhatsApp order
# notifications are enabled. Must be the official WhatsApp Business
# Platform / an official BSP — never browser automation or a QR-session
# library. Leave unset in local development if unused.
WHATSAPP_API_BASE_URL=
# SECRET
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- CORS --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Correlation / audit ---------------------------------------------------
CORRELATION_ID_HEADER=x-correlation-id

# --- PIF product images (PHASE F) -----------------------------------------
# Destination for admin-uploaded product/category images. Must be a
# persistent, writable path in deployment (the files are not in the
# database). The upload is checked by magic bytes and the filename is
# generated server-side; nothing a client sends takes part in either.
PIF_MEDIA_ROOT=var/pif-media
PIF_MEDIA_MAX_BYTES=2000000
